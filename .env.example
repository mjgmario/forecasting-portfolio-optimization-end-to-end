# Environment Configuration Template
# Copy this file to .env and fill in your values
#
# Legend:
#   [REQUIRED] - Must be set for the application to work
#   [OPTIONAL] - Has sensible defaults, set only if needed
#   [RECOMMENDED] - Strongly recommended for production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# [REQUIRED for PostgreSQL] Database connection URL
# Format: postgresql://username:password@host/database?sslmode=require
# Get from: https://console.neon.tech/ -> Project -> Connection Details
# If not set, falls back to local SQLite database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# [OPTIONAL] Database mode: "neon" (PostgreSQL) or "local" (SQLite)
# Default: "neon" if DATABASE_URL is set, otherwise "local"
# DATABASE_MODE=neon

# [OPTIONAL] Local SQLite path (used when DATABASE_URL not set)
# Default: sqlite:///data/forecasting.db
# DATABASE_URL_LOCAL=sqlite:///data/forecasting.db

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# [OPTIONAL] Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
# LOG_LEVEL=INFO

# [OPTIONAL] Log file path (logs to console if not set)
# LOG_FILE=logs/forecasting.log

# ============================================================================
# STREAMLIT CONFIGURATION (for dashboard deployment)
# ============================================================================

# [OPTIONAL] Streamlit server port
# Default: 8501
# STREAMLIT_SERVER_PORT=8501

# [OPTIONAL] Streamlit server address
# Default: localhost (use 0.0.0.0 for external access)
# STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================

# [OPTIONAL] Enable debug mode (verbose output)
# Default: false
# DEBUG=false

# [OPTIONAL] Echo SQL queries to console (for debugging)
# Default: false
# SQL_ECHO=false

# ============================================================================
# GITHUB ACTIONS SECRETS
# ============================================================================
# These should be set as Repository Secrets, not in .env file:
#
# [REQUIRED for CI] DATABASE_URL - Same as above, for GitHub Actions
#   Set in: Repository -> Settings -> Secrets and variables -> Actions
#
# [OPTIONAL] CODECOV_TOKEN - For coverage reporting
#   Get from: https://codecov.io/

# ============================================================================
# CONFIGURATION FILES
# ============================================================================
# Portfolio, forecaster, and allocator settings are in YAML config files:
#
#   config/default.yaml    - Base configuration (version controlled)
#   config/local.yaml      - Personal overrides (gitignored)
#   config/production.yaml - Production settings
#   config/development.yaml - Development settings
#
# See config/default.yaml for all available options.

# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# 1. NEVER commit .env file to git (it's in .gitignore)
# 2. Use strong, unique passwords for database
# 3. Rotate credentials regularly (at least quarterly)
# 4. For production, prefer environment variables over .env file
# 5. Review access logs periodically
